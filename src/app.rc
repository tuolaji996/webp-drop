#include <windows.h>
1 RT_MANIFEST "app.manifest"
101 RCDATA "../.build-deps/libwebp-1.6.0/COPYING"
1 VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "FileDescription", "WebP batch image converter"
      VALUE "ProductName", "WebpDrop"
      VALUE "FileVersion", "1.0.0"
      VALUE "OriginalFilename", "WebpDrop.exe"
      VALUE "LegalCopyright", "Includes libwebp, Copyright Google Inc. BSD license."
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
